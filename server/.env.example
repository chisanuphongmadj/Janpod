# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจาก Supabase > Project Settings > Database > Connection string
# [YOUR-PASSWORD] = รหัสผ่าน database ที่ตั้งตอนสร้างโปรเจกต์

# Transaction pooler (port 6543) — ใช้ตอนแอปรัน
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler / Direct connection (port 5432) — ใช้ตอน prisma migrate
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

PORT=3000
